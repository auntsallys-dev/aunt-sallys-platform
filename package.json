{
  "name": "aunt-sallys",
  "private": true,
  "version": "0.1.0",
  "description": "Aunt Sally's Laundry Platform — multi-tenant monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "html-pdf": "^3.0.1",
    "prettier": "^3.3.3",
    "puppeteer": "^24.40.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.36.4"
    }
  }
}
