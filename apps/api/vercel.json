{
  "version": 2,
  "builds": [
    {
      "src": "src/vercel.ts",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "src/vercel.ts" },
    { "src": "/health", "dest": "src/vercel.ts" },
    { "src": "/assets/(.*)", "dest": "public/assets/$1" },
    { "src": "/(.*)", "dest": "public/index.html" }
  ]
}
