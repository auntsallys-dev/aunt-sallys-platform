# ============================================================
# Aunt Sally's Laundry Platform — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ------ Database ------
DATABASE_URL=postgresql://postgres:password@localhost:5432/aunt_sallys

# ------ Redis ------
REDIS_URL=redis://localhost:6379

# ------ JWT ------
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------ API Server ------
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ------ PayMongo ------
PAYMONGO_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
PAYMONGO_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
PAYMONGO_WEBHOOK_SECRET=whsk_XXXXXXXXXXXXXXXXXXXXXXXX

# ------ Cloudflare R2 ------
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=aunt-sallys
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ------ Resend (Transactional Email) ------
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# ------ Next.js (web app) ------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# ------ React apps (pos/admin) ------
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000
